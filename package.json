{
  "name": "vscode-remote-prune",
  "displayName": "Remote Prune",
  "description": "Clean unused VS Code Stable server installations on Linux Remote-SSH hosts.",
  "version": "0.1.1",
  "publisher": "godxxy",
  "repository": { "type": "git", "url": "https://github.com/godxxy1229/vscode-remote-prune.git" },
  "homepage": "https://github.com/godxxy1229/vscode-remote-prune#readme",
  "bugs": { "url": "https://github.com/godxxy1229/vscode-remote-prune/issues" },
  "icon": "icon/icon_2.png",
  "preview": true,
  "license": "MIT",
  "engines": { "vscode": "^1.85.0" },
  "categories": ["Other"],
  "keywords": ["remote", "ssh", "disk", "cleanup"],
  "extensionKind": ["workspace"],
  "activationEvents": ["onStartupFinished"],
  "main": "./dist/extension.js",
  "capabilities": { "untrustedWorkspaces": { "supported": false }, "virtualWorkspaces": false },
  "contributes": {
    "commands": [
      { "command": "remotePrune.preview", "title": "Remote Prune: Preview Server Cleanup" },
      { "command": "remotePrune.cleanup", "title": "Remote Prune: Clean Selected Server Versions" },
      { "command": "remotePrune.history", "title": "Remote Prune: Show Cleanup History" },
      { "command": "remotePrune.enableAuto", "title": "Remote Prune: Enable Daily Cleanup on This Host" },
      { "command": "remotePrune.disableAuto", "title": "Remote Prune: Disable Daily Cleanup on This Host" }
    ]
  },
  "scripts": {
    "build:native": "node scripts/build-native.cjs",
    "compile": "tsc -p .",
    "vscode:prepublish": "npm run compile",
    "test": "npm run compile && node --test tests/extension.test.cjs",
    "package": "vsce package --no-dependencies --allow-missing-repository"
  },
  "devDependencies": { "@types/node": "^22.0.0", "@types/vscode": "1.85.0", "@vscode/vsce": "^3.0.0", "typescript": "^5.9.0" }
}
